# ===========================================
# MinhaIgreja - .gitignore
# ===========================================

# Dependencies
node_modules/
/.pnp
.pnp.js
jspm_packages/

# Testing
/coverage
.nyc_output

# Production
/dist
/build
*.tsbuildinfo

# Environment (CRÍTICO: Nunca commitar secrets!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.backup

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pm2-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-*

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ===========================================
# Backend Node.js
# ===========================================
backend-nodejs/node_modules/
backend-nodejs/.env
backend-nodejs/logs/
backend-nodejs/uploads/
backend-nodejs/tmp/
backend-nodejs/*.pid

# ===========================================
# Database
# ===========================================
# Database dumps e backups (NÃO incluir)
*.sql.backup
backup_*.json
*_backup*.sql
dump*.sql
*.sql.dump

# Arquivos de teste de banco
*_test*.json
teste_*.csv

# ===========================================
# Temporary files
# ===========================================
$null
*.tmp
*.temp
*.cache
*.swp
*.swo
*~

# ===========================================
# Qwen Code / AI Assistant (OCULTAR)
# ===========================================
.qwen/
.qwenignore
subagents/
agent-*.jsonl
*.agent.*
memory/

# ===========================================
# Lovable / AI Code Generators (OCULTAR)
# ===========================================
lovable-tagger
.vite/
.lovable/

