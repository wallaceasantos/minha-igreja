# ===========================================
# MinhaIgreja - Backend Environment Variables
# ===========================================
# Copie este arquivo para .env e preencha os valores

# ===========================================
# Database (MySQL)
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=igreja_connect

# ===========================================
# Server
# ===========================================
NODE_ENV=development
PORT=3000

# ===========================================
# JWT Secret (produção: use openssl rand -base64 32)
# ===========================================
JWT_SECRET=sua-chave-secreta-aqui

# ===========================================
# Email Configuration (SMTP)
# ===========================================
# Gmail: Ative "App Passwords" em https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-app-password-aqui
SMTP_FROM=MinhaIgreja <noreply@minhaigreja.app>

# ===========================================
# CORS (desenvolvimento)
# ===========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# File Upload Limits (bytes)
# ===========================================
MAX_FILE_SIZE=2097152
MAX_LOGO_SIZE=5242880

# ===========================================
# Trial Configuration
# ===========================================
TRIAL_DURATION_DAYS=30

# ===========================================
# Plan Limits
# ===========================================
FREE_MEMBER_LIMIT=50
FREE_PRAYER_LIMIT=20
ESSENTIAL_MEMBER_LIMIT=200

# ===========================================
# Telegram Notifications (opcional)
# ===========================================
# Crie um bot com @BotFather no Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
