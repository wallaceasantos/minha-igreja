# Backend Igreja Connect - Variáveis de Ambiente
# Copie este arquivo para .env e configure com seus dados

# ================================================================
# APP
# ================================================================
APP_ENV=production
APP_URL=https://ccjv.com.br
APP_DEBUG=false

# ================================================================
# BANCO DE DADOS
# ================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=igreja_connect
DB_USER=root
DB_PASS=sua_senha_aqui
DB_CHARSET=utf8mb4

# ================================================================
# SEGURANÇA
# ================================================================
JWT_SECRET=mude_esta_chave_secreta_em_producao
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=3600

# ================================================================
# EMAIL (SMTP)
# ================================================================
MAIL_HOST=smtp.hostgator.com.br
MAIL_PORT=587
MAIL_USERNAME=seu_email@dominio.com.br
MAIL_PASSWORD=sua_senha
MAIL_FROM=noreply@igrejaconnect.com.br
MAIL_FROM_NAME=Igreja Connect

# ================================================================
# TELEGRAM (Opcional - Para notificações)
# ================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
