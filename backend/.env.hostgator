# ================================================================
# IGREJA CONNECT - Variáveis de Ambiente (HostGator)
# ================================================================
# Copie este arquivo para: /public_html/plataforma/.env
# Preencha com seus dados reais da HostGator
# ================================================================

# ================================================================
# APP
# ================================================================
APP_ENV=production
APP_URL=https://plataforma.ccjv.com.br
APP_DEBUG=false

# ================================================================
# BANCO DE DADOS (HostGator)
# ================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=walla573_ccjv_sistema
DB_USER=walla573_SEU_USUARIO_AQUI
DB_PASS=SUA_SENHA_AQUI
DB_CHARSET=utf8mb4

# ================================================================
# SEGURANÇA
# ================================================================
# Gere uma chave secreta forte: https://randomkeygen.com/
JWT_SECRET=
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=3600

# ================================================================
# EMAIL (SMTP - HostGator)
# ================================================================
MAIL_HOST=smtp.hostgator.com.br
MAIL_PORT=587
MAIL_USERNAME=seu_email@ccjv.com.br
MAIL_PASSWORD=sua_senha_email
MAIL_FROM=noreply@ccjv.com.br
MAIL_FROM_NAME=Igreja Connect
