# .htaccess - Igreja Connect
# Subdomínio: plataforma.ccjv.com.br
# Path: /home2/walla573/plataforma.ccjv.com.br/

# ============================================
# FORÇAR PHP 8.3
# ============================================

# Remover handler anterior
<IfModule mod_mime.c>
    RemoveHandler .php
    RemoveType .php
</IfModule>

# Forçar PHP 8.3 HostGator
<FilesMatch \.php$>
    SetHandler application/x-httpd-php83
</FilesMatch>

# Adicionar tipo MIME
<IfModule mod_mime.c>
    AddType application/x-httpd-php .php
    AddType application/x-httpd-php83 .php
</IfModule>

# ============================================
# REACT ROUTER (SPA)
# ============================================
RewriteEngine On
RewriteBase /

# Forçar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# NÃO tocar em arquivos PHP (deixar executar)
RewriteCond %{REQUEST_URI} \.php$ [NC]
RewriteRule ^ - [L]

# NÃO tocar na pasta api/
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule ^ - [L]

# Se arquivo/diretório existe, serve diretamente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# React Router - Resto vai para index.html
RewriteRule ^(.*)$ index.html [QSA,L]

# ============================================
# SEGURANÇA
# ============================================
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
