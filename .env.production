# ===========================================
# MinhaIgreja - Production Environment
# ===========================================
# Configure estas variáveis no Railway Dashboard
# Não commit valores sensíveis!

# ===========================================
# BACKEND API Configuration
# ===========================================

# Database (Railway MySQL)
# Obter em: https://railway.com/project/<id>/database
DB_HOST=${{MYSQLHOST}}
DB_PORT=${{MYSQLPORT}}
DB_USER=${{MYSQLUSER}}
DB_PASSWORD=${{MYSQLPASSWORD}}
DB_NAME=igreja_connect

# Server
NODE_ENV=production
PORT=3000

# JWT Secret (gere um forte: openssl rand -base64 32)
JWT_SECRET=sua-chave-secreta-ultra-segura-aqui

# ===========================================
# Email Configuration (SMTP)
# ===========================================
# Gmail: Ative "App Passwords" em https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-app-password-aqui
SMTP_FROM=MinhaIgreja <noreply@minhaigreja.app>

# ===========================================
# FRONTEND Configuration
# ===========================================

# API URL (Backend no Railway)
# Formato: https://SEU-SERVIÇO-NAME.up.railway.app/api
VITE_API_URL=https://minhaigreja.up.railway.app/api

# Google Analytics 4 (opcional)
# Obter em: https://analytics.google.com/
# Formato: G-XXXXXXXXXX
VITE_GA_ID=

# ===========================================
# Cloudinary (Upload de Imagens)
# ===========================================
# Obter em: https://cloudinary.com/console
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ===========================================
# Security (Produção)
# ===========================================
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Origins (separado por vísculas)
# Adicione todos os domínios do frontend
CORS_ORIGINS=https://minhaigreja.up.railway.app,https://www.minhaigreja.up.railway.app,http://localhost:5173

# ===========================================
# Telegram Notifications (opcional)
# ===========================================
# Crie um bot com @BotFather no Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===========================================
# File Upload Limits
# ===========================================
MAX_FILE_SIZE=2097152
MAX_LOGO_SIZE=5242880

# ===========================================
# Trial Configuration
# ===========================================
TRIAL_DURATION_DAYS=30

# ===========================================
# Plan Limits
# ===========================================
FREE_MEMBER_LIMIT=50
FREE_PRAYER_LIMIT=20
ESSENTIAL_MEMBER_LIMIT=200
